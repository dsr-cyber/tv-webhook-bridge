# Copy to .env and fill in. Real environment variables override this file.

# Shared secret that every TradingView alert must carry in its "secret" field.
# At least 16 characters. python -c "import secrets; print(secrets.token_urlsafe(24))"
WEBHOOK_SECRET=

# Token for the dashboard and POST /kill. At least 16 characters.
DASHBOARD_TOKEN=

HOST=127.0.0.1
PORT=8000
DB_PATH=bridge.db

# paper or alpaca. If unset: alpaca when both Alpaca keys are present, otherwise paper.
BROKER=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Risk limits
MAX_ALERT_AGE_S=30
MAX_POSITION_PER_SYMBOL=100
MAX_OPEN_POSITIONS=5
DAILY_LOSS_CAP=500
MAX_ORDERS_PER_MINUTE=10
ALLOW_SHORT=false
# Comma separated. Empty means any symbol.
ALLOWED_SYMBOLS=SPY,QQQ,AAPL,MSFT
TRADING_TZ=America/New_York
TRADING_START=09:35
TRADING_END=15:50
TRADING_DAYS=mon,tue,wed,thu,fri

# Optional. Leave empty to skip Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
